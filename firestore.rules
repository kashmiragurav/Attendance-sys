rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEmployee() {
      return isSignedIn() && getUserData().role == 'employee';
    }

    function isCompanyAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || getUserData().role == 'COMPANY_ADMIN');
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'SUPER_ADMIN';
    }

    function sameCompany(companyId) {
      return isSignedIn() && getUserData().companyId == companyId;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (
        isOwnUser(userId) ||
        (isCompanyAdmin() && sameCompany(resource.data.companyId)) ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() && isOwnUser(userId);

      allow update: if isSignedIn() && (
        (isOwnUser(userId) && request.resource.data.role == resource.data.role) ||
        isSuperAdmin()
      );

      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isCompanyAdmin() && sameCompany(resource.data.companyId)) ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == getUserData().companyId;

      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
         resource.data.companyId == getUserData().companyId) ||
        (isCompanyAdmin() && sameCompany(resource.data.companyId)) ||
        isSuperAdmin()
      );

      allow delete: if false;
    }

    match /attendanceEvents/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isCompanyAdmin() && sameCompany(resource.data.companyId)) ||
        isSuperAdmin()
      );

      allow create: if isSignedIn() &&
        request.resource.data.eventId == eventId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId == getUserData().companyId &&
        request.resource.data.employeeId == getUserData().employeeId &&
        request.resource.data.type in ['IN', 'OUT'] &&
        request.resource.data.date is string &&
        request.resource.data.timestamp is timestamp;

      allow update: if false;
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (
        getUserData().companyId == companyId ||
        isSuperAdmin()
      );

      allow write: if isSuperAdmin();
    }

    match /office_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isCompanyAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
